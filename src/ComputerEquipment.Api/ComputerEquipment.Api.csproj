<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ComputerEquipment.Api</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- XML-комментарии попадают в ComputerEquipment.Api.xml; без комментария у публичного члена будет предупреждение CS1591. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <UserSecretsId>51bc4ef1-6377-4c91-b1ee-dc1a7c34c01e</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- Явная версия EF Core: Design ниже подтягивает 10.0.13, но с PrivateAssets=all не передает ее
         в проект тестов, и тесты получили бы 10.0.4 от Npgsql. Версии должны совпадать с Design. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />
    <!-- Нужен только для команд dotnet ef (миграции), в публикацию не попадает. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- Тесты проверяют внутренние классы (например, EquipmentQuery). -->
    <InternalsVisibleTo Include="ComputerEquipment.Api.Tests" />
  </ItemGroup>

</Project>
